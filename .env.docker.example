# Generate a long random value and keep the real .env.docker file private.
BRIDGE_TOKEN=replace-with-a-random-token

# LAN IPv4 address or DNS name that the phone can use to reach this computer.
EVEN_ADVERTISE_HOST=192.168.1.10

# Project exposed to the agent inside the container at /workspace.
PROJECT_PATH=.

# File containing a GitHub token from `gh auth token`. Compose mounts it as a
# Docker secret instead of placing the token in the image or environment.
COPILOT_GITHUB_TOKEN_FILE=./.secrets/copilot-github-token

# Optional overrides.
DEFAULT_PROVIDER=copilot
EVEN_TERMINAL_PORT=3456
COPILOT_MODEL=
